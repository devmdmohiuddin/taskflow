NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://taskflow:taskflow_dev@localhost:5432/taskflow?schema=public

# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

COOKIE_SECRET=replace_with_another_long_random_string_32_chars